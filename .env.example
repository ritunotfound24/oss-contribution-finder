# Optional but recommended: a GitHub personal access token (no scopes needed for public data).
# Raises the API limit from 60 to 5,000 requests/hour.
GITHUB_TOKEN=

# Set to 1 to use the bundled sample data instead of calling GitHub.
DEMO_MODE=0

# Seconds to cache GitHub API responses in memory.
CACHE_TTL_SECONDS=900

# Maximum issues fetched per search.
MAX_ISSUES=60
